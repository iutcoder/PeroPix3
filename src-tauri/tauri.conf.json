{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeroPix",
  "version": "3.0.0",
  "identifier": "io.github.iutcoder.peropix3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PeroPix",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "resources": {
      "../backend/*.py": "backend/",
      "../backend/*.json": "backend/",
      "../backend/requirements.txt": "backend/requirements.txt",
      "../models/censor/": "models/censor/",
      "../public/": "public/",
      "../shared/": "shared/"
    }
  }
}
